{
  "name": "xbrlkit-viewer",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:all": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "feature:create": "./bin/create-feature.sh"
  },
  "//scripts": "The vitest scripts turn off Node's Web Storage: Node 25+ defines `localStorage` on globalThis, undefined until a --localstorage-file is given, and vitest's happy-dom environment does not replace a global the runtime already owns, so tests would read undefined.",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@comunica/query-sparql-rdfjs": "^5.4.1",
    "@robosystems/report-components": "^0.13.1",
    "jq-wasm": "^3.0.0-jq-1.8.2",
    "jsonld": "^9.0.0",
    "n3": "^2.13.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.5.7",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
